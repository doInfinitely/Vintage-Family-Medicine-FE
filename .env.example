# Backend API
# URL of the deployed Express backend (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Site URL (used for sitemap and og:url)
NEXT_PUBLIC_SITE_URL=https://vintagefamilymedicine.com

# Optional: shows a slim red emergency notice bar at the top of the header
# Leave empty or unset if no emergency notice is active
NEXT_PUBLIC_EMERGENCY_NOTICE=
